"""
Login Dialog for Movie Library
"""
from PyQt5.QtWidgets import (
    QDialog, QVBoxLayout, QHBoxLayout, QLabel, 
    QLineEdit, QPushButton, QMessageBox, QFrame, QApplication
)
from PyQt5.QtCore import Qt, pyqtSignal, QTimer
from PyQt5.QtGui import QFont
import requests
import base64


class LoginDialog(QDialog):
    """Login dialog with authentication"""
    
    login_successful = pyqtSignal(str, str)  # username, password
    
    def __init__(self, api_url, parent=None):
        super().__init__(parent)
        self.api_url = api_url
        self.credentials = None
        
        self.setWindowTitle("MovieFlix")
        self.setFixedSize(500, 700)
        self.setModal(True)
        
        # Set window flags for proper display
        self.setWindowFlags(Qt.Dialog | Qt.WindowTitleHint | Qt.WindowCloseButtonHint)
        
        # Center on screen
        self.center_on_screen()
        
        self.setup_ui()
    
    def center_on_screen(self):
        """Center dialog on screen"""
        from PyQt5.QtWidgets import QDesktopWidget
        screen = QDesktopWidget().screenGeometry()
        size = self.geometry()
        self.move(
            (screen.width() - size.width()) // 2,
            (screen.height() - size.height()) // 2
        )
    
    def showEvent(self, event):
        """When dialog is shown, set focus to username field"""
        super().showEvent(event)
        QTimer.singleShot(200, self.focus_username)
    
    def focus_username(self):
        """Focus username input"""
        self.username_input.setFocus()
        self.username_input.activateWindow()
        QApplication.processEvents()
    
    def setup_ui(self):
        """Setup modern Netflix-style login UI"""
        # Main background with subtle gradient
        self.setStyleSheet("""
            QDialog {
                background-color: #141414;
            }
        """)
        
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        
        # Header section with logo
        header = QWidget()
        header.setFixedHeight(120)
        header.setStyleSheet("background-color: #000000;")
        header_layout = QHBoxLayout(header)
        header_layout.setContentsMargins(30, 20, 30, 20)
        
        # Logo
        logo_label = QLabel("MOVIEFLIX")
        logo_label.setStyleSheet("""
            color: #E50914;
            font-size: 32px;
            font-weight: bold;
            letter-spacing: 2px;
        """)
        header_layout.addWidget(logo_label)
        header_layout.addStretch()
        
        layout.addWidget(header)
        
        # Main content area
        content = QWidget()
        content.setStyleSheet("background-color: #141414;")
        content_layout = QVBoxLayout(content)
        content_layout.setContentsMargins(60, 60, 60, 60)
        content_layout.setSpacing(20)
        
        # Card container for form
        card = QWidget()
        card.setFixedWidth(380)
        card.setStyleSheet("""
            QWidget {
                background-color: rgba(0, 0, 0, 0.75);
                border-radius: 8px;
            }
        """)
        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(50, 50, 50, 50)
        card_layout.setSpacing(25)
        
        # Title
        title = QLabel("Sign In")
        title.setStyleSheet("""
            color: white;
            font-size: 32px;
            font-weight: bold;
        """)
        card_layout.addWidget(title)
        
        # Username input
        self.username_input = QLineEdit()
        self.username_input.setPlaceholderText("Email or username")
        self.username_input.setFocusPolicy(Qt.StrongFocus)
        self.username_input.setFixedHeight(50)
        self.username_input.setStyleSheet("""
            QLineEdit {
                background-color: #333333;
                color: white;
                border: 1px solid #555555;
                border-radius: 4px;
                padding: 0 15px;
                font-size: 16px;
            }
            QLineEdit:focus {
                background-color: #454545;
                border: 1px solid #E50914;
                outline: none;
            }
            QLineEdit::placeholder {
                color: #8c8c8c;
            }
        """)
        self.username_input.returnPressed.connect(self.password_input.setFocus)
        card_layout.addWidget(self.username_input)
        
        # Password input
        self.password_input = QLineEdit()
        self.password_input.setPlaceholderText("Password")
        self.password_input.setEchoMode(QLineEdit.Password)
        self.password_input.setFocusPolicy(Qt.StrongFocus)
        self.password_input.setFixedHeight(50)
        self.password_input.setStyleSheet("""
            QLineEdit {
                background-color: #333333;
                color: white;
                border: 1px solid #555555;
                border-radius: 4px;
                padding: 0 15px;
                font-size: 16px;
            }
            QLineEdit:focus {
                background-color: #454545;
                border: 1px solid #E50914;
                outline: none;
            }
            QLineEdit::placeholder {
                color: #8c8c8c;
            }
        """)
        self.password_input.returnPressed.connect(self.on_login)
        card_layout.addWidget(self.password_input)
        
        # Sign in button
        self.login_btn = QPushButton("Sign In")
        self.login_btn.setFixedHeight(50)
        self.login_btn.setCursor(Qt.PointingHandCursor)
        self.login_btn.clicked.connect(self.on_login)
        self.login_btn.setStyleSheet("""
            QPushButton {
                background-color: #E50914;
                color: white;
                border: none;
                border-radius: 4px;
                font-size: 16px;
                font-weight: bold;
            }
            QPushButton:hover {
                background-color: #F40612;
            }
            QPushButton:pressed {
                background-color: #B8070D;
            }
        """)
        card_layout.addWidget(self.login_btn)
        
        # Help text
        help_text = QLabel("Default: admin / admin123")
        help_text.setStyleSheet("""
            color: #737373;
            font-size: 13px;
            margin-top: 10px;
        """)
        help_text.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(help_text)
        
        # Center the card
        content_layout.addStretch()
        content_layout.addWidget(card, alignment=Qt.AlignCenter)
        content_layout.addStretch()
        
        layout.addWidget(content)
        
        # Footer
        footer = QWidget()
        footer.setFixedHeight(60)
        footer.setStyleSheet("background-color: #000000;")
        footer_layout = QVBoxLayout(footer)
        footer_layout.setContentsMargins(20, 10, 20, 10)
        
        footer_text = QLabel("© 2026 MovieFlix - Your Personal Streaming Service")
        footer_text.setStyleSheet("color: #737373; font-size: 12px;")
        footer_text.setAlignment(Qt.AlignCenter)
        footer_layout.addWidget(footer_text)
        
        layout.addWidget(footer)
            }
            QPushButton:hover {
                background-color: #f40612;
            }
            QPushButton:pressed {
                background-color: #c00813;
            }
        """)
        self.login_btn.setCursor(Qt.PointingHandCursor)
        layout.addWidget(self.login_btn)
        
        # Info text
        info = QLabel("Default: admin / admin123\nPress Tab to switch fields")
        info.setStyleSheet("color: #666; font-size: 12px;")
        info.setAlignment(Qt.AlignCenter)
        layout.addWidget(info)
        
        # Skip button (for testing)
        skip_btn = QPushButton("Skip Login (Testing)")
        skip_btn.setFixedHeight(35)
        skip_btn.clicked.connect(self.skip_login)
        skip_btn.setStyleSheet("""
            QPushButton {
                background-color: transparent;
                color: #666;
                border: 1px solid #444;
                border-radius: 4px;
                font-size: 12px;
            }
            QPushButton:hover {
                color: #999;
                border-color: #666;
            }
        """)
        skip_btn.setCursor(Qt.PointingHandCursor)
        layout.addWidget(skip_btn)
        
        layout.addStretch()
        
        # Footer
        footer = QLabel("© 2026 MovieFlix. All rights reserved.")
        footer.setStyleSheet("color: #555; font-size: 11px;")
        footer.setAlignment(Qt.AlignCenter)
        layout.addWidget(footer)
        
        # Set focus to username
        self.username_input.setFocus()
        
        # Debug: Print when input is received
        self.username_input.textChanged.connect(lambda text: print(f"Username input: {text}"))
        self.password_input.textChanged.connect(lambda text: print(f"Password input: {'*' * len(text)}"))
    
    def skip_login(self):
        """Skip login for testing"""
        self.credentials = ("admin", "admin123")
        self.login_successful.emit("admin", "admin123")
        self.accept()
    
    def on_login(self):
        """Handle login attempt"""
        username = self.username_input.text().strip()
        password = self.password_input.text()
        
        if not username or not password:
            QMessageBox.warning(self, "Error", "Please enter both username and password")
            return
        
        # Disable button during login
        self.login_btn.setEnabled(False)
        self.login_btn.setText("Signing in...")
        
        # Try to authenticate
        try:
            # Create basic auth header
            credentials = base64.b64encode(f"{username}:{password}".encode()).decode()
            headers = {"Authorization": f"Basic {credentials}"}
            
            # Test authentication
            response = requests.get(
                f"{self.api_url}/auth/me",
                headers=headers,
                timeout=5
            )
            
            if response.status_code == 200:
                # Login successful
                user_data = response.json()
                self.credentials = (username, password)
                self.login_successful.emit(username, password)
                self.accept()
            else:
                QMessageBox.warning(
                    self,
                    "Login Failed",
                    "Invalid username or password"
                )
                self.login_btn.setEnabled(True)
                self.login_btn.setText("Sign In")
                
        except requests.exceptions.ConnectionError:
            QMessageBox.critical(
                self,
                "Connection Error",
                "Cannot connect to server.\n\nMake sure backend is running:\n.\\start_backend.bat"
            )
            self.login_btn.setEnabled(True)
            self.login_btn.setText("Sign In")
            
        except Exception as e:
            QMessageBox.critical(
                self,
                "Error",
                f"Login failed:\n{str(e)}"
            )
            self.login_btn.setEnabled(True)
            self.login_btn.setText("Sign In")
